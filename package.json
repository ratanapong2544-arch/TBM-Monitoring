{
  "name": "react-typescript",
  "version": "1.0.0",
  "description": "React and TypeScript example starter project",
  "keywords": [
    "typescript",
    "react",
    "starter"
  ],
  "main": "src/index.tsx",
  "dependencies": {
    "loader-utils": "3.2.1",
    "lucide-react": "0.575.0",
    "maplibre-gl": "^5.24.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-is": "19.2.4",
    "react-scripts": "5.0.1",
    "recharts": "3.7.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/react": "18.2.38",
    "@types/react-dom": "18.2.15",
    "fake-indexeddb": "^6.2.5",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.19",
    "typescript": "4.4.4",
    "workbox-build": "^7.4.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build && node tools/build-service-worker.mjs",
    "test": "react-scripts test --env=jsdom",
    "test:pwa": "npm run build && node --test tools/pwa-manifest.test.cjs tools/pwa-build.test.cjs",
    "test:gas-sync": "node --test tools/gas-sync-contract.test.cjs",
    "eject": "react-scripts eject"
  },
  "jest": {
    "globalSetup": "<rootDir>/tools/jest-global-setup.js"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ]
}
